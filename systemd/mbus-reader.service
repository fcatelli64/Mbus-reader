[Unit]
Description=Lettore M-Bus per Home Assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mbus
Group=dialout
ExecStart=/opt/mbus-reader/.venv/bin/mbus-reader -c /etc/mbus-reader/config.yaml run
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
